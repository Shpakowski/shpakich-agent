# ==============================================================================
# Слой инфраструктуры репозитория: Конфигурация исключений Git (.gitignore)
# Защищает репозиторий mcp-coop-agentic-factory от попадания локальных секретов,
# кэшей интерпретаторов (Python / Bun), сборок и временных файлов ОС.
# ==============================================================================

# --- Зависимости и артефакты сборки Bun / TypeScript (Слой 1: CLI-инжектор) ---
# Исключаем директорию пакетов, так как зависимости воспроизводятся из lock-файла
node_modules/
# Исключаем скомпилированные бандлы CLI-инжектора, генерируемые при сборке
dist/
build/
*.tsbuildinfo

# --- Кэш байткода и виртуальные окружения Python (Слой 2-4: Python Core) ---
# Исключаем скомпилированный байткод CPython, чтобы избежать конфликтов между ОС
__pycache__/
*.py[cod]
*$py.class
# Исключаем локальные виртуальные окружения разработчика (ядро работает в Docker)
.venv/
venv/
env/
# Метаданные сборки Python-пакетов (pip / hatchling / setuptools)
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Инструменты тестирования, линтинга и типизации ---
# Кэши pytest, ruff и mypy создаются локально при прогоне проверок
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Секреты и переменные окружения (КРИТИЧНО ДЛЯ БЕЗОПАСНОСТИ) ---
# Запрещаем индексацию файлов с реальными API-ключами (OPENAI_API_KEY, GEMINI_API_KEY)
.env
.env.*
!.env.example

# --- Логи и временные дампы рантайма ---
# Логи контейнеров, отладочные трассировки и локальные слепки БД не должны засорять историю коммитов
*.log
logs/
tmp/
.backups/

# --- Системные и IDE-специфичные файлы (macOS / Linux / Windows) ---
# Метаданные Finder на macOS и временные файлы редакторов
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.swp
*.swo
*~
