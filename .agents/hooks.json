{
  "mcp-coop-context-graph": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/inject_context_map.py 2>/dev/null || python3 ./.agents/hooks/inject_context_map.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/track_file_changes.py 2>/dev/null || python3 ./.agents/hooks/track_file_changes.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/enforce_context_sync.py 2>/dev/null || python3 ./.agents/hooks/enforce_context_sync.py",
        "timeout": 10
      }
    ]
  }
}

