{
  "name": "mcp-coop-agentic-factory",
  "version": "0.1.0",
  "description": "Lightweight dual-runtime (Bun & Node.js) CLI injector and orchestrator for MCP-COOP Agentic Factory",
  "type": "module",
  "bin": {
    "mcp-coop-agentic-factory": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node src/cli/index.ts",
    "build": "tsc",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit && .venv/bin/pyright && .venv/bin/ruff check src/core .agents/hooks"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
